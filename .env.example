# Copy this file to ".env.local" for local development, and set the same
# variable in Vercel (Project → Settings → Environment Variables) for production.

# Your Anthropic API key — get one at https://console.anthropic.com/
# This stays on the SERVER and is never exposed to the browser.
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxxxxxx

# REQUIRED for deployed apps: an access code locking the ENTIRE app — the page
# and every API route, not just the AI ones. Someone with your URL and no code
# sees a login screen and nothing else. A production deployment FAILS CLOSED
# without this. Pick any code you can type on your phone — the app asks once per
# device and remembers it for 30 days. Changing it signs every device out.
# Leave blank only for local development, where the gate is disabled.
APP_SECRET=

# ── Phase 2: eBay posting (not required for sorting/writing listings) ─────────
# From your eBay keyset at https://developer.ebay.com/. You can reuse your
# existing keyset's App ID + Cert ID, as long as you create a NEW, dedicated
# RuName for this web app (so the Python lister's RuName stays untouched).
# Leave these blank until you're ready for posting.
EBAY_CLIENT_ID=
EBAY_CLIENT_SECRET=
EBAY_RU_NAME=
# Which eBay to talk to. Leave blank (or anything but "sandbox") for the real
# site. Set to "sandbox" on a DEV deployment and every eBay call — listing,
# ending, relisting, offers, orders, photo upload — goes to eBay's test
# environment instead, and a purple SANDBOX banner appears on every page.
#
# Sandbox needs its OWN keyset: the three variables above must then be your
# sandbox App ID / Cert ID / RuName, not your production ones. Get them from
# developer.ebay.com → Application Keys → Sandbox, and point the sandbox
# RuName's accepted URL at your dev deployment's /api/ebay/callback.
#
# Note: OAuth SCOPE strings still read "api.ebay.com" in sandbox — they are
# identifiers, not endpoints, and the app deliberately does not rewrite them.
EBAY_ENV=
# Random secret used to encrypt your stored eBay connection. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=
# Your deployed app URL, used for the OAuth redirect (e.g. https://your-app.vercel.app)
APP_URL=
# Optional: your ZIP code. Only used once, to create an eBay inventory location
# if your account doesn't already have one. Defaults to 10001 if unset.
EBAY_LOCATION_POSTAL_CODE=

# Optional: default package weight/size sent to eBay so CALCULATED-shipping
# policies can publish (eBay returns error 25020 if weight is missing). Weight is
# in ounces (16 = 1 lb); dimensions are in inches. You can still edit weight/size
# on each listing in eBay afterward. Defaults: 16 oz, 12 x 9 x 3 in.
EBAY_DEFAULT_PACKAGE_WEIGHT_OZ=16
EBAY_DEFAULT_PACKAGE_LENGTH_IN=12
EBAY_DEFAULT_PACKAGE_WIDTH_IN=9
EBAY_DEFAULT_PACKAGE_HEIGHT_IN=3

# Optional: storewide markup (percent) applied to every auto-suggested price
# (AI estimate + the comps "use median" button) before you review it. For
# sellers running a permanent store-level sale that discounts everything.
# 40 lists at 1.4x. Heads-up: +40% then a 40%-off sale nets 84% of the
# original — to land back on the suggested price after an X%-off sale, set
# 100*X/(100-X), e.g. ~66.7 for 40% off. Leave blank for no markup.
PRICE_MARKUP_PERCENT=

# Optional: override the built-in shipping rate table (see lib/shipping/rates.ts).
# The costs shown in the app are estimates for margin maths, not live carrier
# quotes. The weight and box size ARE sent to eBay, so calculated shipping quotes
# buyers at real current rates from them. A malformed value here is ignored.
SHIPPING_RATES_JSON=
